---
import "@/styles/global.scss";
import { Font } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LayoutGrid from "@/components/LayoutGrid.astro";
import Seo from "@/components/Seo.astro";
import VisualEditing from "@/components/VisualEditing.astro";
import { isPreview } from "@/utils/sanity";
import { getSettings } from "@/utils/settings";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const settings = await getSettings();
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-body" preload />
    <Seo
      settings={settings}
      title={title}
      description={description}
      image={image}
      noindex={noindex || isPreview}
    />
    <ClientRouter />
  </head>
  <body>

    <LayoutGrid columns={12} columnsMd={8} columnsSm={4} />
    <Header settings={settings} />
    <main transition:animate={fade({ duration: "0.4s" })}>
      <slot />
    </main>
    <Footer settings={settings} />
   
    {isPreview && <VisualEditing />}
  </body>
</html>
