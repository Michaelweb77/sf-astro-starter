---
import { PortableText } from "astro-portabletext";
import type { TypedObject } from "astro-portabletext/types";
import CodeBlock from "@/components/CodeBlock.astro";

interface Props {
  value: TypedObject[];
  "data-sanity"?: string;
}

const { value, ...attrs } = Astro.props;

// Wlasne komponenty dla typow spoza standardowego Portable Text
const components = {
  type: {
    code: CodeBlock,
  },
};
---

<div class="rich_text" {...attrs}>
  <PortableText value={value} components={components} />
</div>

<style lang="scss">
  /* Tresc z CMS to HTML spoza komponentu, stad :global() zakotwiczone w .rich_text */
  .rich_text {
    max-width: var(--content-max);
  }

  .rich_text :global(h2),
  .rich_text :global(h3),
  .rich_text :global(h4) {
    margin-top: var(--space-l);
    margin-bottom: var(--space-s);
  }

  .rich_text :global(h2) {
    font-size: var(--font-size-xl);
  }

  .rich_text :global(h3) {
    font-size: var(--font-size-l);
  }

  .rich_text :global(p),
  .rich_text :global(ul),
  .rich_text :global(ol),
  .rich_text :global(blockquote) {
    margin-bottom: var(--space-s);
  }

  .rich_text :global(ul) {
    padding-left: 2rem;
    list-style: disc;
  }

  .rich_text :global(ol) {
    padding-left: 2rem;
    list-style: decimal;
  }

  .rich_text :global(blockquote) {
    padding-left: var(--space-s);
    border-left: 0.4rem solid var(--color-text);
    font-style: italic;
  }

  .rich_text :global(a) {
    color: var(--color-accent);
  }
</style>
