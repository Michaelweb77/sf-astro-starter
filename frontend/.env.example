# Wymagane - ID projektu Sanity (npm create sanity wpisuje je samo)
PUBLIC_SANITY_STUDIO_PROJECT_ID="<your-project-id>"
# Wymagane - dataset projektu Sanity
PUBLIC_SANITY_STUDIO_DATASET="production"
# Adres strony produkcyjnej - canonical, Open Graph, sitemap, RSS
PUBLIC_SITE_URL="http://localhost:4321"

# --- Tryb podgladu (Presentation tool / Visual Editing) ---
# "true" = SSR + wersje robocze + nakladki edycji. Puste/false = produkcja (SSG).
PUBLIC_SANITY_VISUAL_EDITING_ENABLED="false"
# Token Viewer z sanity.io/manage -> API -> Tokens. Potrzebny tylko w trybie podgladu.
SANITY_API_READ_TOKEN=""
# Adres Studio, do ktorego prowadza nakladki. Bez tej linii: http://localhost:3333
# PUBLIC_SANITY_STUDIO_URL="https://twoj-projekt.sanity.studio"
